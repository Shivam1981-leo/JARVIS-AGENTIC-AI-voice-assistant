# ===================================================================
# J.A.R.V.I.S. Environment Variables Configuration
# ===================================================================

# --- Core LLM Configurations ---
# Google Gemini API Key (Required for LangGraph Agent)
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Anthropic Claude Configuration (Vision & Fallback Agent)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_BASE_URL=http://localhost:20128/v1
ANTHROPIC_MODEL=kr/claude-sonnet-4.5

# --- Email Tool (send_email) ---
# Requires Gmail 2-Factor Authentication + App-Specific Password
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_USER=your_email@gmail.com
GMAIL_PASSWORD=your_gmail_app_password

# --- Optional API Keys ---
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here
HF_TOKEN=your_huggingface_token_here
HF_HUB_DISABLE_SYMLINKS_WARNING=1
